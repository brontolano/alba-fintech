# ===========================================================
# ALBA Finance – Environment Variables Example
# ===========================================================
# Copy file ini ke .env (dev) dan .env.production (prod),
# lalu isi nilai-nilai sesuai environment kamu.
#
# JANGAN commit file .env/.env.production ke repo.
# ===========================================================

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ALBA Finance"

# ---------- Database (MySQL) ----------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://u826712707_alba:CHANGE_ME@127.0.0.1:3306/u826712707_alba"

# ---------- Auth (NextAuth.js) ----------
NEXTAUTH_URL=http://localhost:3000
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_BASE64_32_BYTES

# ---------- AI Assistant (OpenRouter compatible) ----------
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=CHANGE_ME
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---------- Optional: Node env ----------
NODE_ENV=development
