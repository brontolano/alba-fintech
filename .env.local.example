# ALBA-APPS Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ALBA-APPS

# ===========================================
# DATABASE
# ===========================================
# Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/alba_apps?schema=public"

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars

# ===========================================
# LLM CUSTOM ENDPOINT (AI Assistant)
# ===========================================
LLM_ENDPOINT=https://9router-dk0n.srv1167690.hstgr.cloud/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=Hamdan-MAX

# ===========================================
# WHATSAPP INTEGRATION (n8n + WAHA)
# ===========================================
# WAHA (WhatsApp HTTP API) - self-hosted
WAHA_BASE_URL=http://your-vps-ip:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=alba-session

# n8n (workflow automation)
N8N_BASE_URL=http://your-vps-ip:5678
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=https://webhook.yourdomain.com/webhook

# WhatsApp Business API (Meta) - alternative to WAHA
# WHATSAPP_TOKEN=your-meta-whatsapp-token
# WHATSAPP_PHONE_ID=your-phone-number-id
# WHATSAPP_VERIFY_TOKEN=your-random-verify-token
# WHATSAPP_APP_SECRET=your-meta-app-secret

# ===========================================
# FILE STORAGE
# ===========================================
# Local storage (development)
UPLOAD_DIR=./public/uploads

# Cloudinary (production)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# OFFLINE / PWA
# ===========================================
NEXT_PUBLIC_SW_ENABLED=true
NEXT_PUBLIC_OFFLINE_DAYS=7

# ===========================================
# FEATURE FLAGS
# ===========================================
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true