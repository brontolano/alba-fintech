// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support native enums. Values are kept as Strings
// and constrained at the application layer via TS unions in `src/lib/enums.ts`.

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String
  name                String
  image               String?
  role                String    // Pimpinan, Manager, Staff
  unit                String    // Kantor, Kantin, Koperasi, All
  unitType            String    @default("Sederhana") // Sederhana, Retail
  retailModuleEnabled Boolean   @default(false)
  createdAt           DateTime  @default(now())

  transactions    Transaction[]   @relation("UserTransactions")
  approvedTrans   Transaction[]   @relation("ApprovedTransactions")
  approvals       Approval[]
  reconciliations Reconciliation[]
  posSales        PosSale[]
  inventoryItems  InventoryItem[]
  movements     StockMovement[]
  opnames       StockOpname[]
  auditLogs     AuditLog[]
  notifications   Notification[]
  openedShifts CashierShift[] @relation("OpenedShifts")
  closedShifts CashierShift[] @relation("ClosedShifts")
  purchaseOrders PurchaseOrder[] @relation("UserPurchaseOrders")
}

model SystemConfig {
  id        Int      @id @default(1)
  appName   String   @default("ALBA Finance")
  appLogo   String?
  updatedAt DateTime @updatedAt
}

model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int
  transactionDate DateTime
  unit            String
  type            String    // Debit, Kredit
  method          String    // Tunai, Transfer
  category        String
  amount          Decimal
  description     String?
  photoUrl        String?
  status          String    @default("Submitted") // Draft, Submitted, Pending, Approved, Rejected
  approvedById    Int?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User       @relation("UserTransactions", fields: [userId], references: [id])
  approvedBy User?      @relation("ApprovedTransactions", fields: [approvedById], references: [id])
  approvals  Approval[]
}

model Approval {
  id            Int       @id @default(autoincrement())
  transactionId Int
  approverId    Int
  level         String    // Manager, Pimpinan
  status        String    // Approved, Rejected
  notes         String?
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  approver    User        @relation(fields: [approverId], references: [id])
}

model Reconciliation {
  id                 Int       @id @default(autoincrement())
  userId             Int
  reconciliationDate DateTime
  unit               String
  physicalCash       Decimal
  digitalBalance     Decimal
  difference         Decimal
  notes              String?
  status             String    @default("Pending") // Pending, Validated
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // Debit, Kredit
  unit      String   // Kantor, Kantin, Koperasi, All
  createdAt DateTime @default(now())
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  unitName  String    // Kantor, Kantin, Koperasi
  createdAt DateTime  @default(now())

  purchaseOrders PurchaseOrder[] @relation("SupplierPurchaseOrders")
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  supplierId   Int
  unitName     String    // Kantor, Kantin, Koperasi
  orderDate    DateTime  @default(now())
  totalAmount  Decimal
  status       String    @default("Pending") // Pending, Received, Cancelled
  receivedAt   DateTime?
  notes        String?
  createdById  Int
  createdAt    DateTime  @default(now())

  supplier Supplier @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  createdBy User @relation("UserPurchaseOrders", fields: [createdById], references: [id])
  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([unitName, status])
}

model PurchaseOrderItem {
  id          Int       @id @default(autoincrement())
  purchaseOrderId Int
  inventoryId Int
  quantity    Int
  unitPrice   Decimal
  subtotal    Decimal

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventory InventoryItem @relation("PurchaseOrderInventory", fields: [inventoryId], references: [id])

  @@index([purchaseOrderId])
}

model InventoryItem {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String?   @unique
  category    String?
  imageUrl    String?
  buyPrice    Decimal?
  sellPrice   Decimal
  unit        String    // pcs, dus, kg, botol
  stock       Int       @default(0)
  minStock    Int       @default(0)
  unitName    String    // Kantor, Kantin, Koperasi, All
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
  saleItems PosSaleItem[]
  movements StockMovement[]
  opnames   StockOpname[]
  purchaseOrderItems PurchaseOrderItem[] @relation("PurchaseOrderInventory")
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  inventoryId   Int
  type          String   // IN, OUT
  quantity      Int
  note          String?
  createdById   Int
  createdAt     DateTime @default(now())

  inventory InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
}

model StockOpname {
  id            Int      @id @default(autoincrement())
  inventoryId   Int
  physicalStock Int
  difference    Int
  note          String?
  createdById   Int
  createdAt     DateTime @default(now())

  inventory InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
}

model PosSale {
  id           Int       @id @default(autoincrement())
  unitName     String    // Kantor, Kantin, Koperasi
  totalAmount  Decimal
  paymentMethod String   // Tunai, Transfer
  status       String   @default("Completed") // Completed, Refunded, Void
  refundOfId   Int?      // nullable self relation
  refundOf     PosSale?  @relation("PosRefund", fields: [refundOfId], references: [id])
  refunds      PosSale[] @relation("PosRefund")
  shiftId      Int?
  createdAt    DateTime  @default(now())
  createdById  Int

  createdBy User         @relation(fields: [createdById], references: [id])
  items     PosSaleItem[]
  shift     CashierShift? @relation(fields: [shiftId], references: [id])
}

model CashierShift {
  id        Int       @id @default(autoincrement())
  unitName  String    // Kantor, Kantin, Koperasi
  openedBy  Int
  closedBy  Int?
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  openingCash Decimal
  closingCash Decimal?
  cashDifference Decimal?
  note      String?
  status    String    @default("Open") // Open, Closed

  openedByUser User   @relation("OpenedShifts", fields: [openedBy], references: [id])
  closedByUser User?  @relation("ClosedShifts", fields: [closedBy], references: [id])
  sales     PosSale[]

  @@index([unitName, status])
}

model PosSaleItem {
  id            Int       @id @default(autoincrement())
  posSaleId     Int
  inventoryId   Int
  quantity      Int
  priceAtSale   Decimal
  subtotal      Decimal
  createdAt     DateTime  @default(now())

  posSale   PosSale       @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  inventory InventoryItem @relation(fields: [inventoryId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  action     String   // create/update/delete/approve/reject/config_change
  entity     String   // Transaction, User, InventoryItem, SystemConfig, PosSale
  entityId   Int
  metadata   String?  // JSON string summary
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   // approval, stock, transaction, system
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
